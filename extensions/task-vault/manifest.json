{
  "id": "terminator.task-vault",
  "name": "Task Vault",
  "version": "0.1.3",
  "description": "GTD+BuJo+PARA daily productivity system backed by the shared SQLite database.",
  "main": "src/index.js",
  "renderer": "dist/index.html",
  "minAppVersion": "0.1.0",
  "contributes": {
    "globalTab": {
      "label": "Task Vault",
      "icon": "calendar",
      "view": "main"
    },
    "sidebarPanel": {
      "label": "Vault Calendar",
      "icon": "calendar",
      "defaultOpen": false,
      "view": "calendar"
    },
    "commands": [
      {
        "id": "task-vault:capture-to-inbox",
        "label": "Capture to inbox",
        "description": "Quick-capture a task to the vault inbox",
        "mnemonic": "c"
      },
      {
        "id": "task-vault:open",
        "label": "Open Task Vault",
        "description": "Open the vault on a task"
      }
    ],
    "quickActions": {
      "group": {
        "mnemonic": "v",
        "label": "Task Vault"
      }
    },
    "usage": [
      {
        "id": "task-create",
        "label": "Create a task"
      },
      {
        "id": "inbox-process",
        "label": "Process an inbox item"
      },
      {
        "id": "task-complete",
        "label": "Complete a task"
      },
      {
        "id": "view-daily-log",
        "label": "Open the daily log"
      },
      {
        "id": "view-areas",
        "label": "Open areas"
      },
      {
        "id": "view-projects",
        "label": "Open projects"
      },
      {
        "id": "view-archive",
        "label": "Open the archive"
      },
      {
        "id": "file-to",
        "label": "File to a project or area"
      },
      {
        "id": "session-link",
        "label": "Link a task to a session"
      },
      {
        "id": "db-admin",
        "label": "Open database admin"
      }
    ]
  }
}
