{
  "id": "terminator.task-vault",
  "name": "Task Vault",
  "version": "0.1.0",
  "description": "GTD+BuJo+PARA daily productivity system backed by plain markdown files. Includes MCP server for agent access.",
  "main": "src/index.js",
  "renderer": "dist/index.html",
  "minAppVersion": "0.1.0",
  "contributes": {
    "globalTab": {
      "label": "Task Vault",
      "icon": "calendar",
      "view": "main"
    },
    "sidebarPanel": {
      "label": "Vault Calendar",
      "icon": "calendar",
      "defaultOpen": false,
      "view": "calendar"
    },
    "commands": [
      {
        "id": "task-vault:capture-to-inbox",
        "label": "Capture to inbox",
        "description": "Quick-capture a task to the vault inbox",
        "mnemonic": "c"
      }
    ],
    "quickActions": { "group": { "mnemonic": "v", "label": "Task Vault" } }
  }
}
