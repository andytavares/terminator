{
  "id": "terminator.foundry",
  "name": "Foundry",
  "version": "0.1.7",
  "description": "A software factory: converge an idea into a work order, then build, verify and ship it.",
  "main": "src/index.js",
  "renderer": "dist/index.html",
  "minAppVersion": "0.1.0",
  "contributes": {
    "workspaceTab": {
      "label": "Foundry",
      "icon": "brain",
      "view": "main"
    },
    "quickActions": {
      "group": {
        "mnemonic": "f",
        "label": "Foundry"
      }
    },
    "startWorkOptions": [
      {
        "id": "new-order",
        "label": "Foundry order",
        "description": "Shaped, planned and built by Foundry's line.",
        "command": "new-order"
      }
    ],
    "shellRoots": ["terminator.foundry.dataDir"],
    "usage": [
      {
        "id": "forge-turn",
        "label": "Send a Forge turn"
      },
      {
        "id": "floor",
        "label": "Factory floor"
      },
      {
        "id": "gate-decide",
        "label": "Decide a gate"
      },
      {
        "id": "inbox",
        "label": "Inbox"
      },
      {
        "id": "ledger",
        "label": "Ledger"
      },
      {
        "id": "orders",
        "label": "Orders"
      },
      {
        "id": "budget-edit",
        "label": "Edit budgets"
      },
      {
        "id": "profile-edit",
        "label": "Edit a repository's checks"
      },
      {
        "id": "run-start",
        "label": "Start a run"
      },
      {
        "id": "run-resume",
        "label": "Resume a run"
      },
      {
        "id": "ship",
        "label": "Order opened its pull request"
      },
      {
        "id": "go-to-run",
        "label": "Go to a run"
      }
    ]
  }
}
