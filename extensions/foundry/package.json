{
  "name": "@terminator/extension-foundry",
  "version": "0.1.18",
  "private": true,
  "description": "Foundry — a software factory for Terminator",
  "scripts": {
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/typecheck/extensions-foundry-tsconfig.tsbuildinfo -p tsconfig.json && tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/typecheck/extensions-foundry-tsconfig.test.tsbuildinfo -p tsconfig.test.json",
    "lint": "oxlint .",
    "test": "cd ../.. && vitest run extensions/foundry/",
    "test:coverage": "cd ../.. && vitest run extensions/foundry/ --coverage.enabled --coverage.reportsDirectory=extensions/foundry/coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@terminator/extension-sdk": "6.3.0",
    "@terminator/extension-ui": "1.0.0",
    "js-yaml": "5.5.0",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@terminator/test-support": "1.0.0"
  }
}
