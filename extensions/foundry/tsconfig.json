{
  // The gate that a blank extension panel got past.
  //
  // `npm run typecheck:extensions` has pointed here since the script was
  // written, and this file did not exist — so it failed with "the specified
  // path does not exist" and nothing typechecked the extension at all. The
  // root `tsconfig.json` is `files: []` plus project references with no
  // `--build`, so it checks nothing either, and the components are not in any
  // of the three referenced projects.
  //
  // What that cost: `RULE_ICON` in `Inbox.tsx` is `Record<GateRuleId, ...>`,
  // a new gate rule was added without an entry, `<Icon />` got `undefined`,
  // React threw and unmounted the tree, and every Foundry surface rendered
  // empty. The build was green and 2,293 unit tests passed.
  //
  // `noEmit`: the bundles are built by esbuild and vite, never by tsc.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    // The core's own sources are checked by their own project; this one only
    // needs the Extension API's types to resolve.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
