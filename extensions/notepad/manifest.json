{
  "id": "terminator.notepad",
  "name": "Notepad",
  "version": "0.1.2",
  "description": "Markdown notepad with live preview, margin comments, tags, and full-text search.",
  "main": "src/index.js",
  "renderer": "dist/index.html",
  "minAppVersion": "0.1.0",
  "contributes": {
    "globalTab": {
      "label": "Notes",
      "icon": "file",
      "view": "main"
    },
    "windowViews": [
      {
        "id": "notepad-note",
        "view": "note"
      },
      {
        "id": "notepad-diagram",
        "view": "diagram"
      }
    ],
    "commands": [
      {
        "id": "notepad:quick-create",
        "label": "New note",
        "description": "Open quick-create overlay",
        "shortcut": "\u2318\u21e7N",
        "mnemonic": "n"
      }
    ],
    "quickActions": {
      "group": {
        "mnemonic": "n",
        "label": "Notes"
      }
    },
    "usage": [
      {
        "id": "note-create",
        "label": "Create note"
      },
      {
        "id": "search",
        "label": "Search notes"
      },
      {
        "id": "comment",
        "label": "Add comment"
      },
      {
        "id": "tag",
        "label": "Add tag"
      },
      {
        "id": "export",
        "label": "Export notes"
      },
      {
        "id": "outline",
        "label": "Use outline"
      },
      {
        "id": "diagram-create",
        "label": "Create diagram"
      }
    ]
  }
}
