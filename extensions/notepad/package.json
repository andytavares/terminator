{
  "name": "@terminator/extension-notepad",
  "version": "0.1.8",
  "private": true,
  "description": "Markdown Notepad extension for Terminator",
  "scripts": {
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/typecheck/extensions-notepad-tsconfig.tsbuildinfo -p tsconfig.json && tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/typecheck/extensions-notepad-tsconfig.test.tsbuildinfo -p tsconfig.test.json",
    "lint": "oxlint .",
    "test": "cd ../.. && vitest run extensions/notepad/",
    "test:coverage": "cd ../.. && vitest run extensions/notepad/ --coverage.enabled --coverage.reportsDirectory=extensions/notepad/coverage"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/common": "1.5.4",
    "@lezer/markdown": "1.8.1",
    "@terminator/extension-sdk": "6.3.0",
    "@terminator/extension-ui": "1.0.0",
    "js-yaml": "5.5.0",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@terminator/test-support": "1.0.0"
  }
}
