{
  "name": "@terminator/extension-remote-control",
  "version": "1.0.6",
  "private": true,
  "description": "Remote Control extension for Terminator — embedded HTTP server + ngrok tunnel",
  "scripts": {
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/typecheck/extensions-remote-control-tsconfig.tsbuildinfo -p tsconfig.json && tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/typecheck/extensions-remote-control-tsconfig.test.tsbuildinfo -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "cd ../.. && vitest run extensions/remote-control/"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "@fastify/websocket": "11.3.4",
    "@terminator/extension-sdk": "6.3.0",
    "@terminator/extension-ui": "1.0.0",
    "fastify": "5.12.7",
    "lucide-react": "1.61.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
