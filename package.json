{
  "name": "@andytavares/terminator",
  "version": "0.1.144",
  "description": "Extension-first AI-focused terminal emulator",
  "main": "out/main/index.js",
  "type": "module",
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "clean": "rm -rf out/main out/preload out/renderer out/renderer-remote",
    "build:extensions": "node scripts/build-extensions.cjs",
    "build:remote": "vite build --config vite.config.remote.ts",
    "dev": "npm run clean && npm run build:extensions && npm run build:remote && electron-vite dev",
    "build": "npm run clean && npm run build:extensions && npm run build:remote && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage --reporter=verbose --reporter=junit \"--outputFile.junit=test-report.junit.xml\"",
    "lint": "eslint .",
    "lint:deps": "syncpack lint",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p packages/extension-ui && tsc --noEmit -p packages/extension-sdk && npm run typecheck:extensions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-extension": "node scripts/create-extension.cjs",
    "package": "npm run build:extensions && npm run build:remote && electron-vite build && electron-builder --mac --arm64 --publish never",
    "prepare": "husky",
    "typecheck:extensions": "tsc -p extensions/foundry/tsconfig.json && tsc -p extensions/git-integration/tsconfig.json && tsc -p extensions/notepad/tsconfig.json && tsc -p extensions/task-vault/tsconfig.json && tsc -p extensions/remote-control/tsconfig.json",
    "storybook": "npm run storybook -w @terminator/extension-ui",
    "build-storybook": "npm run build-storybook -w @terminator/extension-ui",
    "test:stories": "npm run test:stories -w @terminator/extension-ui"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint",
      "vitest related --run"
    ],
    "*.{js,cjs}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@linear/sdk": "91.0.0",
    "@terminator/extension-ui": "1.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-store": "8.2.0",
    "lucide-react": "1.21.0",
    "node-pty": "1.2.0-beta.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.8",
    "playwright": "1.61.0",
    "prettier": "3.3.3",
    "syncpack": "15.3.3",
    "typescript": "5.5.4",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.5",
    "vitest": "4.1.11",
    "ws": "8.21.0"
  },
  "overrides": {
    "brace-expansion@^5": "5.0.12",
    "fast-uri": "3.1.8",
    "find-my-way": "9.7.0",
    "js-yaml@4": "4.3.2",
    "postcss": "8.5.24",
    "tar": "7.5.22"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "node-pty": false,
    "electron-winstaller": false,
    "esbuild@0.27.2": true
  }
}
