{
  "name": "@andytavares/terminator",
  "version": "0.1.206",
  "description": "Extension-first AI-focused terminal emulator",
  "main": "out/main/index.js",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "extensions/*",
    "packages/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "clean": "rm -rf out/main out/preload out/renderer out/renderer-remote",
    "build:extensions": "node scripts/build-extensions.cjs",
    "build:remote": "vite build --config vite.config.remote.ts",
    "predev": "install-electron",
    "dev": "npm run clean && npm run build:extensions && npm run build:remote && npm run build:termctl && electron-vite dev",
    "build": "npm run clean && npm run build:extensions && npm run build:remote && npm run build:termctl && electron-vite build",
    "prepreview": "install-electron",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:mutation": "stryker run",
    "test:watch": "vitest",
    "pretest:e2e": "install-electron",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage --reporter=verbose --reporter=junit \"--outputFile.junit=test-report.junit.xml\"",
    "lint": "turbo run lint lint:root --output-logs=errors-only",
    "lint:deps": "TMPDIR=node_modules/.cache syncpack lint && node scripts/check-single-copies.mjs",
    "lint:unused": "knip",
    "lint:duplicates": "jscpd",
    "lint:workflows": "node scripts/workflow-lint.mjs",
    "check": "npm run check:repo && npm run check:packages",
    "typecheck": "turbo run typecheck typecheck:specs --output-logs=errors-only",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content --cache-location node_modules/.cache/prettier/format-check .",
    "create-extension": "node scripts/create-extension.cjs",
    "package": "npm run build:extensions && npm run build:remote && npm run build:termctl && electron-vite build && electron-builder --mac --arm64 --publish never",
    "prepare": "husky",
    "storybook": "npm run storybook -w @terminator/extension-ui",
    "build-storybook": "npm run build-storybook -w @terminator/extension-ui",
    "test:stories": "npm run test:stories -w @terminator/extension-ui",
    "test:visual": "npm run test:visual -w @terminator/extension-ui",
    "postinstall": "patch-package",
    "lint:root": "oxlint . --ignore-pattern 'packages/**' --ignore-pattern 'extensions/**' --ignore-pattern 'apps/**'",
    "typecheck:specs": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck/tsconfig.test.tsbuildinfo -p tsconfig.test.json",
    "build:termctl": "npm run build -w @terminator/termctl",
    "test:root": "TERMINATOR_TESTS=root vitest run --coverage.enabled=${CI:-false}",
    "check:repo": "turbo run lint:deps lint:unused lint:duplicates lint:workflows format:check lint:root typecheck:specs test:root test:lint-rules --output-logs=errors-only",
    "check:packages": "turbo run lint typecheck test --output-logs=errors-only",
    "check:packages:ci": "turbo run lint typecheck test:coverage --output-logs=errors-only",
    "test:lint-rules": "vitest run tests/integration/lint/"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "oxlint"
    ],
    "*.{js,cjs}": [
      "prettier --write",
      "oxlint"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.89.1",
    "@agentclientprotocol/sdk": "2.0.2",
    "@linear/sdk": "99.0.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@terminator/extension-sdk": "6.3.0",
    "@terminator/extension-ui": "1.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-store": "12.0.0",
    "electron-updater": "6.8.11",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "node-pty": "1.2.0-beta.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/parser": "8.0.8",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "js-yaml": "5.5.0",
    "jscpd": "5.4.2",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "patch-package": "8.0.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "syncpack": "15.3.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "overrides": {
    "brace-expansion@^5": "5.0.12",
    "fast-uri": "3.1.8",
    "find-my-way": "9.7.0",
    "js-yaml@4": "4.3.2",
    "playwright-core": "1.64.1",
    "postcss": "8.5.24",
    "tar": "7.5.22",
    "@agentclientprotocol/claude-agent-acp": {
      ".": "0.89.1",
      "zod": "4.6.7"
    },
    "body-parser@2": "2.4.0",
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "5.1.16"
      }
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty": false,
    "electron-winstaller": false
  }
}
