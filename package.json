{
  "name": "@andytavares/terminator",
  "version": "0.1.174",
  "description": "Extension-first AI-focused terminal emulator",
  "main": "out/main/index.js",
  "type": "module",
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "clean": "rm -rf out/main out/preload out/renderer out/renderer-remote",
    "build:extensions": "node scripts/build-extensions.cjs",
    "build:remote": "vite build --config vite.config.remote.ts",
    "predev": "install-electron",
    "dev": "npm run clean && npm run build:extensions && npm run build:remote && electron-vite dev",
    "build": "npm run clean && npm run build:extensions && npm run build:remote && electron-vite build",
    "prepreview": "install-electron",
    "preview": "electron-vite preview",
    "test": "node scripts/test-select.mjs --run unit",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:watch": "vitest",
    "pretest:e2e": "install-electron",
    "test:e2e": "playwright test",
    "ci:local": "node scripts/ci-local.mjs",
    "ci:local:e2e": "node scripts/ci-e2e-local.mjs",
    "test:coverage": "vitest run --coverage --reporter=verbose --reporter=junit \"--outputFile.junit=test-report.junit.xml\"",
    "lint": "node scripts/lint.mjs",
    "lint:deps": "syncpack lint",
    "lint:unused": "knip",
    "lint:unused:production": "knip --production",
    "lint:duplicates": "jscpd",
    "lint:release-age": "node scripts/check-release-age.mjs",
    "lint:single-copies": "node scripts/check-single-copies.mjs",
    "lint:quarantine": "node scripts/check-quarantine.mjs",
    "lint:workflows": "node scripts/workflow-lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier/format-check .",
    "create-extension": "node scripts/create-extension.cjs",
    "package": "npm run build:extensions && npm run build:remote && electron-vite build && electron-builder --mac --arm64 --publish never",
    "prepare": "husky",
    "storybook": "npm run storybook -w @terminator/extension-ui",
    "build-storybook": "npm run build-storybook -w @terminator/extension-ui",
    "test:stories": "npm run test:stories -w @terminator/extension-ui",
    "test:visual": "npm run test:visual -w @terminator/extension-ui",
    "postinstall": "patch-package"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint",
      "vitest related --run"
    ],
    "*.{js,cjs}": [
      "prettier --write",
      "eslint"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.89.1",
    "@agentclientprotocol/sdk": "1.8.0",
    "@linear/sdk": "91.0.0",
    "@terminator/extension-sdk": "6.1.0",
    "@terminator/extension-ui": "1.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-store": "8.2.0",
    "electron-updater": "6.8.10",
    "lucide-react": "1.21.0",
    "node-pty": "1.2.0-beta.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.6",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "js-yaml": "4.3.2",
    "jscpd": "5.4.1",
    "jsdom": "29.1.1",
    "knip": "6.39.0",
    "lint-staged": "17.0.8",
    "patch-package": "8.0.1",
    "playwright": "1.61.0",
    "prettier": "3.3.3",
    "syncpack": "15.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "ws": "8.21.0"
  },
  "overrides": {
    "brace-expansion@^5": "5.0.12",
    "fast-uri": "3.1.8",
    "find-my-way": "9.7.0",
    "js-yaml@4": "4.3.2",
    "postcss": "8.5.24",
    "tar": "7.5.22",
    "@agentclientprotocol/claude-agent-acp": {
      ".": "0.89.1",
      "zod": "4.6.6"
    },
    "body-parser@2": "2.4.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "node-pty": false,
    "electron-winstaller": false,
    "esbuild@0.27.2": true
  }
}
