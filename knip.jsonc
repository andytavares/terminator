// Unused files, exports and dependencies: `npm run lint:unused`.
// https://knip.dev/reference/configuration
// https://knip.dev/features/monorepos-and-workspaces
// Plugins find most entries on their own: electron-vite (main, preload and
// renderer inputs), vite, vitest, playwright, storybook and the package.json
// `exports` of the SDK and the design system, whose exports are their API.
{
  "$schema": "https://unpkg.com/knip@6.39.0/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{cjs,mjs,mts,js}",
        // Bundled by esbuild from a string: git-integration-contrast.spec.ts:139.
        "tests/e2e/git-integration-contrast.entry.tsx",
        // electron-builder reads its config file by name
        // (https://www.electron.build/configuration); `npm run package`.
        "electron-builder.cjs",
        // Run by path as the e2e profiles' agent: tests/e2e/helpers.ts (STUB_AGENT).
        "tests/e2e/fixtures/acp-stub-agent.mjs",
      ],
      // Tools the e2e stubs call on the runner's PATH: openssl makes the stub
      // servers' throwaway CA (tracker-stub.ts, jira-stub.ts) and jq shapes the
      // gh stub's --jq output (github-stub-gh.ts). Both ship on GitHub's runners.
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}"],
      "ignoreBinaries": ["openssl", "jq", "footprint"],
      "vite": { "config": ["vite.config.remote.ts"] },
      "vitest": { "config": ["vitest.config.ts", "vitest.live.config.ts"] },
      // tests/integration/remote-bridge-allowlist.spec.ts drives Remote Control's
      // bridge route against the core's allowlist, so it imports the server
      // packages that extensions/remote-control/package.json declares.
      // The Claude agent's process runs the adapter by path, resolved with createRequire:
      // packages/core-main/src/agents/acp/agent-registry.ts.
      "ignoreDependencies": [
        "fastify",
        "@fastify/websocket",
        "@agentclientprotocol/claude-agent-acp",
      ],
    },
    // The core packages import each other, and every workspace's specs import packages/test-support,
    // by relative path. Each declares those packages so Turborepo's package graph knows which
    // packages a change reaches.
    "packages/core-main": {
      // electron.vite.config.ts's main inputs: the app and the extension host, a utilityProcess.
      "entry": ["src/index.ts", "src/extensions/host/entry.ts"],
      "ignoreDependencies": ["@terminator/core-shared", "@terminator/test-support"],
    },
    "packages/core-renderer": {
      "entry": [
        // Reached only through electron.vite.config.ts's alias for mermaid's ELK chunk.
        "src/components/agent/no-elk-layout.ts",
        // vite.config.remote.ts's frameShim input.
        "extension-frame/frame-shim.ts",
      ],
      "ignoreDependencies": ["@terminator/core-shared", "@terminator/test-support"],
    },
    "packages/core-renderer-remote": {
      // The scripts of index.html and mobile.html, built by vite.config.remote.ts.
      "entry": ["src/main.tsx", "src/mobile.main.tsx"],
      "ignoreDependencies": ["@terminator/core-shared", "@terminator/test-support"],
    },
    "apps/termctl": {
      // The command's entry, bundled by scripts/build-termctl.mjs.
      "entry": ["src/bin.ts"],
      // Its integration specs start core-main's MCP server by relative path.
      "ignoreDependencies": [
        "@terminator/core-main",
        "@terminator/core-shared",
        "@terminator/test-support",
      ],
    },
    "packages/extension-ui": {
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}"],
      "playwright": { "config": ["playwright.visual.config.ts"] },
      "vitest": { "config": ["vitest.stories.config.ts"] },
      "ignoreDependencies": ["@terminator/test-support"],
    },
    "packages/extension-sdk": {
      "ignoreDependencies": ["@terminator/test-support"],
    },
    "packages/core-shared": {
      "ignoreDependencies": ["@terminator/test-support"],
    },
    "extensions/*": {
      "entry": ["src/index.ts"],
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}"],
      "vite": { "config": ["vite.renderer.config.mts"] },
      "ignoreDependencies": ["@terminator/test-support"],
    },
    "extensions/git-integration": {
      "entry": ["src/index.ts"],
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}"],
      "vite": { "config": ["vite.renderer.config.mts"] },
      // Loaded by path at run time: require.resolve of each grammar's .wasm,
      // src/review/symbols.ts:52.
      "ignoreDependencies": ["@vscode/tree-sitter-wasm", "@terminator/test-support"],
    },
    "extensions/remote-control": {
      "entry": ["src/index.ts"],
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}"],
      "vite": { "config": ["vite.renderer.config.mts"] },
      // The ngrok CLI the user installs; found with `which ngrok`,
      // src/server/ngrok-manager.ts:37.
      "ignoreBinaries": ["ngrok"],
      "ignoreDependencies": ["@terminator/test-support"],
    },
  },
}
