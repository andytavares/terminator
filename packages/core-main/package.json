{
  "name": "@terminator/core-main",
  "version": "1.0.0",
  "private": true,
  "description": "The Electron main process, the preload and the extension host",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/typecheck/packages-core-main-tsconfig.tsbuildinfo -p tsconfig.json && tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/typecheck/packages-core-main-tsconfig.test.tsbuildinfo -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "cd ../.. && vitest run packages/core-main/"
  },
  "dependencies": {
    "@terminator/core-shared": "1.0.0",
    "@terminator/extension-sdk": "6.3.0"
  },
  "devDependencies": {
    "@terminator/test-support": "1.0.0"
  }
}
