{
  "name": "@terminator/extension-ui",
  "version": "1.0.0",
  "description": "The shared UI floor for Terminator: one dialog, one confirmation, one toast, one empty state, one layer scale — used by the core app and every extension.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/extension-ui.css",
    "./tokens.css": "./src/tokens.css",
    "./extension-base-css": "./src/extension-base-css.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "peerDependencies": {
    "lucide-react": "1.21.0",
    "react": "18.3.1"
  },
  "license": "MIT"
}
