{
  "name": "@terminator/extension-ui",
  "version": "1.0.0",
  "description": "The shared UI floor for Terminator: one dialog, one confirmation, one toast, one empty state, one layer scale — used by the core app and every extension.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/extension-ui.css",
    "./tokens.css": "./src/tokens.css",
    "./controls.css": "./src/controls.css",
    "./settings-fields.css": "./src/settings-fields.css",
    "./extension-base-css": "./src/extension-base-css.ts",
    "./fonts": "./src/fonts.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --config vitest.stories.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "peerDependencies": {
    "lucide-react": "1.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.64.0",
    "storybook": "10.6.2"
  },
  "license": "MIT"
}
