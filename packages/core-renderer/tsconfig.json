{
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "rootDir": "..",
    "paths": {
      "@shared/*": ["../core-shared/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "extension-frame/**/*",
    "../core-shared/src/**/*",
    "../core-main/src/preload.ts"
  ]
}
