{
  "name": "@terminator/extension-sdk",
  "version": "4.0.0",
  "description": "The Extension API declaration and the helpers every Terminator extension shares",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    },
    "./renderer": {
      "types": "./src/renderer.tsx",
      "import": "./src/renderer.tsx"
    },
    "./types/renderer": {
      "types": "./types/renderer.d.ts"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "license": "MIT"
}
