{
  "name": "@terminator/extension-sdk",
  "version": "6.1.0",
  "description": "The Extension API declaration and the helpers every Terminator extension shares",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./plain": {
      "types": "./src/plain.ts",
      "import": "./src/plain.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    },
    "./renderer": {
      "types": "./src/renderer.tsx",
      "import": "./src/renderer.tsx"
    },
    "./types/renderer": {
      "types": "./types/renderer.d.ts"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "vite": "7.3.7"
  },
  "license": "MIT"
}
