{
  "name": "@terminator/extension-sdk",
  "version": "6.3.0",
  "description": "The Extension API declaration and the helpers every Terminator extension shares",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./plain": {
      "types": "./src/plain.ts",
      "import": "./src/plain.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    },
    "./renderer": {
      "types": "./src/renderer.tsx",
      "import": "./src/renderer.tsx"
    },
    "./types/renderer": {
      "types": "./types/renderer.d.ts"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    }
  },
  "files": [
    "src",
    "types"
  ],
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@terminator/test-support": "1.0.0",
    "vite": "8.3.5"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/typecheck/packages-extension-sdk-tsconfig.tsbuildinfo -p tsconfig.json",
    "lint": "oxlint .",
    "test": "cd ../.. && vitest run packages/extension-sdk/",
    "test:coverage": "cd ../.. && vitest run packages/extension-sdk/ --coverage.enabled --coverage.reportsDirectory=packages/extension-sdk/coverage"
  }
}
