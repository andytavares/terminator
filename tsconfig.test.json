{
  // Type-checks the core's specs (`npm run typecheck`). The specs import from
  // main, renderer and shared alike, so this starts from the renderer config
  // (DOM, JSX, `@shared/*`) and adds Node and Vitest's globals. Extensions and
  // packages type-check their own sources.
  "extends": "./tsconfig.renderer.json",
  "compilerOptions": {
    "composite": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    // The scripts specs import .mjs; their types are inferred, not checked.
    "allowJs": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "tests/unit/**/*",
    "tests/integration/**/*",
    "tests/support/**/*",
    "tests/setup.ts",
    "src/renderer/electron-api.d.ts"
  ]
}
